{
  "manifest_version": 3,
  "name": "Following First",
  "version": "1.0.1",
  "description": "X's home timeline opens on Following instead of For you.",
  "yab": { "site_actions": ["clicks"] },
  "content_scripts": [
    {
      "matches": ["https://x.com/*"],
      "js": ["page/page.js"],
      "run_at": "document_end"
    }
  ]
}
